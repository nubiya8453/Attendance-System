# Aegis AI Attendance System - SMTP Email Configurations
# =======================================================
# To send actual email alerts to student inboxes, fill in the credentials below.
# If these are left blank or commented out, the system will run in "Simulation Mode",
# logging the emails to 'data/emails.json' and displaying them in the dashboard UI.

# 1. SMTP Provider Settings (Gmail defaults provided below)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# 2. Faculty Sender Account Details
# IMPORTANT: For Gmail, do NOT use your account password. You must generate 
# a 16-character "App Password" via your Google Account security panel.
SMTP_USER=nubiyafathima0@gmail.com
SMTP_PASS=uymi wtro zaav hiqz
